<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <StartupObject>Monopoly.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- Se resguardan módulos experimentales y herramientas PLUS sin romper la compilación principal -->
  <ItemGroup>
    <Compile Remove="UI_WindowsForms_Experimental/**" />
    <None Include="UI_WindowsForms_Experimental/**" />
    <Compile Remove="ControladorSerial_PLUS/**" />
    <None Include="ControladorSerial_PLUS/**" />
  </ItemGroup>
</Project>